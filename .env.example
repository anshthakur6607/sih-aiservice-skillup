# MoSPI SkillUp AI Service Configuration
# Copy this to .env and fill in your values

# Google Gemini API Configuration
GOOGLE_API_KEY=your-google-gemini-api-key-here

# AI Service Security
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_API_KEY=your-secure-ai-service-api-key-here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AWS S3 Configuration (Optional - for course material ingestion)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=mospi-course-materials
AWS_REGION=ap-south-1

# Sarvam AI / Bhashini API Configuration (Optional - for multilingual)
SARVAM_API_KEY=your-sarvam-ai-api-key
BHASHINI_API_KEY=your-bhashini-api-key

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=mospi_knowledge_base

# Server Configuration
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Logging
LOG_LEVEL=INFO